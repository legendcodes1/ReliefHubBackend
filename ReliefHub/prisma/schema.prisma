generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model body_parts {
  id         String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String      @db.VarChar
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  exercises  exercises[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model discomfort_level {
  id         String      @id @db.Uuid
  level      Int?        @db.SmallInt
  created_at DateTime    @default(now()) @db.Timestamptz(6)
  exercises  exercises[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model exercises {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  title               String                @db.VarChar
  description         String
  video_url           String                @db.VarChar
  safety_notes        String
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  updated_at          DateTime?             @default(now()) @db.Timestamptz(6)
  body_part_id        String                @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  discomfort_level_id String                @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  body_parts          body_parts            @relation(fields: [body_part_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  discomfort_level    discomfort_level      @relation(fields: [discomfort_level_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  routine_completions routine_completions[]
  saved_exercise      saved_exercise[]
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model routine_completions {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  notes       String
  user_id     String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercise_id String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercises   exercises @relation(fields: [exercise_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model saved_exercise {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  created_at  DateTime  @default(now()) @db.Timestamptz(6)
  exercise_id String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String    @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  exercises   exercises @relation(fields: [exercise_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users       users     @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model users {
  id                  String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username            String                @unique @db.VarChar
  email               String                @unique
  created_at          DateTime              @default(now()) @db.Timestamptz(6)
  routine_completions routine_completions[]
  saved_exercise      saved_exercise[]
}
